# Money, the prod stand: the studio's real money.
#
# No secret lives in this file, and none may be added: Money has none to keep.
# That is why the file is in git. tests/test_repo_hygiene.py fails when a key
# appears here that it does not know.
#
# Plain KEY=value lines, no quotes, no spaces around "=". deploy/stand.sh reads
# them as they stand and hands them to compose.
MONEY_STAND=prod
MONEY_PUBLIC_URL=https://finance.selfstudio.se
MONEY_FOUNDERS=mika:Mika,misha:Misha,vanya:Vanya
MONEY_PORT=5191
MONEY_DATA_HOST_DIR=/var/lib/money/prod
