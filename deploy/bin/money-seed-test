#!/bin/sh
# Return Money's TEST stand to the fabricated studio, as of today.
#
#   money-seed-test
#
# Run by money-deploy-test (when the stand is empty, or with --reseed) and
# every night at 00:10 UTC by money-test-reseed.timer.
#
# The studio is made by scripts/money-demo.mjs, the generator that travels
# with the page. It runs here exactly as the checkout holds it: in a throwaway
# container with no network and a read-only root, reading nothing but the
# scripts folder -
#
#   docker run --rm --network none --read-only -v /opt/money-dev/scripts:/s:ro \
#     node:22-alpine node /s/money-demo.mjs <ledger|plan> <YYYY-MM-DD>
#
# Its two documents then go in through the stand's own save door
# (`ctl seed <ledger|plan> --fresh`), with a session of a few minutes that the
# stand makes for itself. So there is no robot login and no password anywhere,
# and every seeding also proves the write path.
#
# After that EVERY snapshot of the stand is purged (`ctl purge-snapshots
# --older-than-days 0`). A seed is a save, and a save keeps what it replaces
# as the day's copy - which is exactly what was typed or uploaded on test
# since the night before. Purging only the copies older than two days left
# that one on the disk for three nights. With all of them gone after each
# reseed, a real statement put on test by mistake lives a day at most: out of
# the document, and out of every copy, by the next successful reseed. The
# data is fabricated, so nothing is lost with the copies.
#
# Both documents are made first and stored after: a generator that fails
# leaves the stand as it was. A save by somebody in the same moment makes the
# stand refuse a seed (409); that is tried once more. Accounts and passwords
# survive a seeding.
#
# A night that fails is seen: the unit turns "failed", money-deploy-test says
# so at its next run, and so do the words at login
# (deploy/motd/97-money-test-reseed).
#
# Exit status: 0 seeded; 3 the generator is not in the checkout; anything else
# is a failure, and the lines above it say where.
set -eu

LOCK=/run/lock/money-deploy.lock
LOCK_WAIT_SECONDS=300
NODE_IMAGE=node:22-alpine
# 0: every snapshot goes. See above before raising it.
KEEP_SNAPSHOT_DAYS=0

die() {
  echo "money-seed-test: $*" >&2
  exit 1
}

# Where this file really is: on the server it is run through a link in
# /usr/local/bin, and by the timer under its full name.
SELF=$0
while [ -L "$SELF" ]; do
  TARGET=$(readlink "$SELF")
  case "$TARGET" in
    /*) SELF=$TARGET ;;
    *) SELF=$(dirname "$SELF")/$TARGET ;;
  esac
done
ROOT=$(cd "$(dirname "$SELF")/../.." && pwd)
STAND_SH=$ROOT/deploy/stand.sh
GENERATOR=$ROOT/scripts/money-demo.mjs

if [ $# -ne 0 ]; then
  echo "usage: money-seed-test" >&2
  exit 2
fi

if [ ! -f "$GENERATOR" ]; then
  echo "money-seed-test: $GENERATOR is not in the checkout, so there is nothing to seed from" >&2
  exit 3
fi
if ! command -v docker >/dev/null 2>&1; then
  die "docker is not installed"
fi

# A deploy in progress is waited for, not raced: the container it is about to
# replace is the one this would be talking to. A deploy that calls this
# already holds the lock and says so.
if [ "${MONEY_DEPLOY_LOCK_HELD:-}" != 1 ]; then
  if ! command -v flock >/dev/null 2>&1; then
    die "flock is not installed"
  fi
  exec 9>"$LOCK"
  if ! flock -w "$LOCK_WAIT_SECONDS" 9; then
    die "a Money deploy has held $LOCK for more than $LOCK_WAIT_SECONDS s. Nothing was seeded."
  fi
  MONEY_DEPLOY_LOCK_HELD=1
  export MONEY_DEPLOY_LOCK_HELD
fi

# "Today" as the page reckons it: the date in London.
DAY=$(TZ=Europe/London date +%Y-%m-%d)

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
# dash, which is /bin/sh on the server, runs the line above only when the
# script ends by itself. A Ctrl-C, a dropped connection or systemd's timeout
# has to be turned into an ending first.
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

for WHAT in ledger plan; do
  if ! docker run --rm --network none --read-only -v "$ROOT/scripts:/s:ro" "$NODE_IMAGE" \
    node /s/money-demo.mjs "$WHAT" "$DAY" > "$WORK/$WHAT.json"; then
    die "the generator failed on the $WHAT. Nothing was seeded."
  fi
  FIRST=$(head -c 1 "$WORK/$WHAT.json")
  if [ "$FIRST" != "{" ]; then
    die "the generator did not print a document for the $WHAT. Nothing was seeded."
  fi
done

for WHAT in ledger plan; do
  if ! "$STAND_SH" test ctl seed "$WHAT" --fresh < "$WORK/$WHAT.json"; then
    echo "money-seed-test: the stand did not take the $WHAT; trying once more" >&2
    sleep 2
    if ! "$STAND_SH" test ctl seed "$WHAT" --fresh < "$WORK/$WHAT.json"; then
      die "the stand did not take the $WHAT"
    fi
  fi
done

if ! "$STAND_SH" test ctl purge-snapshots --older-than-days "$KEEP_SNAPSHOT_DAYS"; then
  die "the documents are in, but the stand's snapshots could not be purged: what the seed replaced is still in them"
fi

if [ "$KEEP_SNAPSHOT_DAYS" -eq 0 ]; then
  echo "money-test: seeded with the fabricated studio as of $DAY; every snapshot purged"
else
  echo "money-test: seeded with the fabricated studio as of $DAY; snapshots older than $KEEP_SNAPSHOT_DAYS days purged"
fi
